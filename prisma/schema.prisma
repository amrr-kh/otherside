generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Admin & customers ----------

enum AdminRole {
  OWNER
  STAFF
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         AdminRole @default(OWNER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Customer {
  id        String    @id @default(cuid())
  name      String
  phone     String
  email     String?
  addresses Address[]
  orders    Order[]
  wishlist  Wishlist?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([phone])
}

model Address {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  governorate String
  city        String
  street      String
  building    String
  floor       String?
  apartment   String?
  landmark    String?
  createdAt   DateTime @default(now())

  @@index([customerId])
}

// ---------- Catalog ----------

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductGender {
  WOMEN
  MEN
  UNISEX
}

enum ImageRole {
  FRONT
  BACK
  SIDE
  DETAIL
  FIT
  LIFESTYLE
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  sortOrder Int       @default(0)
  products  Product[]
}

model Collection {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  isNewDrop   Boolean   @default(false)
  sortOrder   Int       @default(0)
  products    Product[] @relation("ProductCollections")
}

model Product {
  id               String           @id @default(cuid())
  name             String
  slug             String           @unique
  shortDescription String
  fullDescription  String
  basePrice        Decimal          @db.Decimal(10, 2)
  compareAtPrice   Decimal?         @db.Decimal(10, 2)
  status           ProductStatus    @default(DRAFT)
  gender           ProductGender    @default(UNISEX)
  material         String?
  fit              String?
  care             String?
  featured         Boolean          @default(false)
  isNewDrop        Boolean          @default(false)
  trending         Boolean          @default(false)
  categoryId       String?
  category         Category?        @relation(fields: [categoryId], references: [id])
  collections      Collection[]     @relation("ProductCollections")
  options          ProductOption[]
  variants         ProductVariant[]
  images           ProductImage[]
  wishlistItems    WishlistItem[]
  reviews          Review[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status])
}

model ProductOption {
  id        String               @id @default(cuid())
  productId String
  product   Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int                  @default(0)
  values    ProductOptionValue[]

  @@index([productId])
}

model ProductOptionValue {
  id        String        @id @default(cuid())
  optionId  String
  option    ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  value     String
  sortOrder Int           @default(0)
  swatchHex String?

  variants ProductVariant[] @relation("VariantOptionValues")
  images   ProductImage[]

  @@index([optionId])
}

model ProductVariant {
  id            String               @id @default(cuid())
  productId     String
  product       Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku           String               @unique
  priceOverride Decimal?             @db.Decimal(10, 2)
  isActive      Boolean              @default(true)
  optionValues  ProductOptionValue[] @relation("VariantOptionValues")
  inventory     Inventory?
  cartItems     CartItem[]
  orderItems    OrderItem[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([productId])
}

model Inventory {
  id                String         @id @default(cuid())
  variantId         String         @unique
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity          Int            @default(0)
  lowStockThreshold Int            @default(3)
  updatedAt         DateTime       @updatedAt
}

model ProductImage {
  id                 String             @id @default(cuid())
  productId          String
  product            Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  colorOptionValueId String
  colorOptionValue   ProductOptionValue @relation(fields: [colorOptionValueId], references: [id], onDelete: Cascade)
  url                String
  role               ImageRole
  sortOrder          Int                @default(0)
  isPrimary          Boolean            @default(false)

  @@index([productId, colorOptionValueId])
}

// ---------- Cart ----------

model Cart {
  id          String     @id @default(cuid())
  cookieToken String     @unique
  items       CartItem[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model CartItem {
  id            String         @id @default(cuid())
  cartId        String
  cart          Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId     String
  variant       ProductVariant @relation(fields: [variantId], references: [id])
  quantity      Int
  priceSnapshot Decimal        @db.Decimal(10, 2)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([cartId, variantId])
}

// ---------- Orders ----------

enum OrderStatus {
  RECEIVED
  CONFIRMED
  PREPARING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  COD
  INSTAPAY
  MOBILE_WALLET
  // EASYKASH — planned post-launch gateway integration.
}

model Order {
  id               String               @id @default(cuid())
  orderNumber      String               @unique
  customerId       String
  customer         Customer             @relation(fields: [customerId], references: [id])
  status           OrderStatus          @default(RECEIVED)
  subtotal         Decimal              @db.Decimal(10, 2)
  shippingCost     Decimal              @db.Decimal(10, 2)
  total            Decimal              @db.Decimal(10, 2)
  paymentMethod    PaymentMethod        @default(COD)
  // Manual confirmation until EasyKash is integrated: COD collected, or an
  // InstaPay/mobile wallet transfer verified by an admin.
  paymentConfirmed Boolean              @default(false)
  addressSnapshot  Json
  trackingNumber   String?
  notes            String?
  items            OrderItem[]
  statusHistory    OrderStatusHistory[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([customerId])
}

model OrderItem {
  id                  String          @id @default(cuid())
  orderId             String
  order               Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId           String?
  variant             ProductVariant? @relation(fields: [variantId], references: [id])
  productNameSnapshot String
  colorSnapshot       String
  sizeSnapshot        String
  unitPrice           Decimal         @db.Decimal(10, 2)
  quantity            Int

  @@index([orderId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId])
}

// ---------- Shipping & discounts ----------

model ShippingZone {
  id                    String   @id @default(cuid())
  name                  String
  governorates          String[]
  price                 Decimal  @db.Decimal(10, 2)
  etaText               String
  freeShippingThreshold Decimal? @db.Decimal(10, 2)
  isActive              Boolean  @default(true)
}

enum DiscountType {
  PERCENT
  FIXED
}

model DiscountCode {
  id          String       @id @default(cuid())
  code        String       @unique
  type        DiscountType
  value       Decimal      @db.Decimal(10, 2)
  minSubtotal Decimal?     @db.Decimal(10, 2)
  expiresAt   DateTime?
  usageLimit  Int?
  timesUsed   Int          @default(0)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
}

// ---------- Wishlist & reviews ----------

model Wishlist {
  id         String         @id @default(cuid())
  customerId String?        @unique
  customer   Customer?      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  guestToken String?        @unique
  items      WishlistItem[]
  createdAt  DateTime       @default(now())
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([wishlistId, productId])
}

model Review {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerName String
  rating       Int
  body         String
  isApproved   Boolean  @default(false)
  isDemo       Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([productId])
}

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  subscribedAt DateTime @default(now())
}
