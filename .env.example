DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Direct (non-pooled) connection — used only by the Prisma CLI for migrations
# and db push. On Neon this is the same host as DATABASE_URL with "-pooler"
# removed. The running app never uses this one.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Generate with: npx auth secret
AUTH_SECRET=""

# Optional — sets the first admin login when seeding. If left blank, the seed
# script falls back to owner@otherside.local / otherside-admin.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Optional — new-order email alert via Resend (resend.com). Leave blank to
# skip the email notification entirely.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="OtherSide Orders <orders@otherside-store.com>"
ADMIN_NOTIFICATION_EMAIL=""

# Optional — new-order WhatsApp alert via Twilio (twilio.com). Leave blank to
# skip the WhatsApp notification entirely. TWILIO_WHATSAPP_FROM is the
# Twilio-provided sandbox/production WhatsApp number, e.g. +14155238886.
# ADMIN_WHATSAPP_TO is the phone that should receive the alert, e.g. +201...
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""
ADMIN_WHATSAPP_TO=""

# Optional — logs every order to a Google Sheet via a Google Apps Script Web
# App URL (see the setup steps in chat). Leave blank to skip.
GOOGLE_SHEETS_WEBHOOK_URL=""

# Optional — powers the "Website Traffic" section of /admin/analytics via the
# Google Analytics Data API. Leave both blank to skip it (the storefront GA4
# tag itself is unaffected either way — this only feeds the admin dashboard).
# GA4_PROPERTY_ID: the numeric Property ID (NOT the G-XXXXXXX measurement ID)
#   — find it in analytics.google.com -> Admin (gear icon, bottom left) ->
#   Property Settings -> "Property details", or in the URL after you open the
#   property: analytics.google.com/.../a<ACCOUNT_ID>p<PROPERTY_ID>/...
# GA4_SERVICE_ACCOUNT_KEY: a Google Cloud service account's JSON key file,
#   base64-encoded into one line (see the setup steps in chat for how to
#   create the service account and give it Viewer access to this property).
#   Never commit the raw JSON key file anywhere.
GA4_PROPERTY_ID=""
GA4_SERVICE_ACCOUNT_KEY=""
